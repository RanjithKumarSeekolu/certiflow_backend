PORT=8081
NODE_ENV=development

# Local Docker Postgres (docker compose up postgres)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/certiflow?schema=public"
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5432/certiflow?schema=public"

REDIS_URL="redis://localhost:6379"
RABBITMQ_URL="amqp://guest:guest@localhost:5672"

# Required. Generate one: openssl rand -hex 32
JWT_SECRET=""

# Reviewer persona switching (POST /api/auth/demo-login). Must be "false" in production.
DEMO_MODE="true"

PUBLIC_APP_URL="http://localhost:8081"

# Optional tuning (defaults shown)
# SLA_HOURS=48
# CORS_ORIGIN="http://localhost:5173,http://localhost:3000"
